{:paths ["resources"]

 ;; Sibling checkouts during development go in the untracked local.deps.edn:
 ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:test
 ;; hive-vessel is a runtime dependency here: the eval-port route lowers
 ;; :ui/* ops through hive-vessel's standard registry, and hive.emacs does
 ;; not bring hive-vessel onto the classpath.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.hive-agi/hive-olympus {:mvn/version "0.1.7"}
        io.github.hive-agi/hive-vessel {:mvn/version "0.1.8"}}

 :aliases
 {:test {:extra-paths ["test"]
         :jvm-opts ["-Xmx1g"]
         :main-opts ["-m" "hive-olympus-emacs.test-runner"]}

  ;; Real Emacs probe: a private daemon, never the user's session.
  ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:probe
  :probe {:extra-paths ["dev" "test"]
          :jvm-opts ["-Xmx1g"]
          :main-opts ["-m" "hive-olympus-emacs.probe"]}}}
